---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTASection from "../components/CTASection.astro";
import { Image } from "astro:assets";
import { quotePath, type ServiceId } from "../data/services";

import ensuiteImg from "../assets/images/ensuite-large-format-porcelain-tiling-wellington.webp";
import showerTealImg from "../assets/images/shower-tiling-vertical-stack-teal-tile-wellington.webp";
import splashbackFlutedImg from "../assets/images/kitchen-splashback-fluted-terracotta-tile-wellington.webp";
import walkInShowerImg from "../assets/images/walk-in-shower-tiling-linear-drain-wellington.webp";
import whiteGlossImg from "../assets/images/shower-tiling-white-gloss-wall-tile-wellington.webp";
import windowSeatImg from "../assets/images/patterned-tile-window-seat-wellington.webp";
import floorFeatureImg from "../assets/images/bathroom-floor-tiling-feature-strip-wellington.webp";
import subwayImg from "../assets/images/kitchen-splashback-subway-tile-wellington.webp";

const title = "Tiling Portfolio Wellington | ROH Tiling";
const description =
  "Recent tiling projects across Wellington by ROH Tiling. Ensuites, walk-in showers, kitchen splashbacks and feature tiling — photographed on site.";
const canonical = "/portfolio";
const breadcrumbs = [{ name: "Home", url: "/" }, { name: "Portfolio" }];

/**
 * Every project links to the service page it belongs to.
 * `wip` marks work-in-progress shots so the caption frames them honestly —
 * green gib and unfitted joinery read as proof of process, not sloppiness.
 */
const projects = [
  {
    id: "ensuite-large-format-porcelain",
    title: "Ensuite — Large-Format Porcelain, Frameless Shower",
    image: ensuiteImg,
    alt: "Finished ensuite with large-format grey porcelain wall tiles, frameless glass shower and wall-hung basin, tiled by ROH Tiling in Wellington",
    description:
      "A completed ensuite finished in large-format grey porcelain, run floor to ceiling to keep grout lines to a minimum. The frameless glass shower meets the tiled wall with a clean silicone junction, and the wall-hung basin required precise cuts around the mixer and waste penetrations. Large-format tile is unforgiving — the substrate has to be flat before a single sheet goes up.",
    service: {
      href: "/services/bathroom-tiling",
      label: "bathroom & ensuite tiling",
    },
    tags: [
      "Bathroom Tiling",
      "Large-Format Porcelain",
      "Ensuite",
      "Frameless Shower",
    ],
    wip: false,
  },
  {
    id: "teal-stack-bond-shower",
    title: "Walk-in Shower — Teal Vertical Stack Bond",
    image: showerTealImg,
    alt: "Walk-in shower with teal vertical stack-bond wall tiles, dark large-format floor tiles and a linear drain, under a skylight",
    description:
      "Teal wall tiles laid in a vertical stack bond, which is the least forgiving layout there is — every joint runs dead straight top to bottom, so any drift in the first course shows all the way up. Dark large-format floor tiles are set to fall toward a linear drain, under a skylight that shows up every grout line.",
    service: {
      href: "/services/bathroom-tiling",
      label: "shower & bathroom tiling",
    },
    tags: ["Shower Tiling", "Stack Bond", "Linear Drain", "Feature Colour"],
    wip: true,
  },
  {
    id: "walk-in-shower-linear-drain",
    title: "Walk-in Shower — Tiled Hob and Linear Drain",
    image: walkInShowerImg,
    alt: "Walk-in shower with grey large-format tiles, tiled hob and linear drain set to fall",
    description:
      "Grey large-format tiles over a tiled hob, with the floor set to fall evenly into a linear drain. The photograph shows the tiled hob, floor layout and drain during installation. The waterproofing layer is not visible; this image does not establish the system or its documentation.",
    service: {
      href: "/services/waterproofing",
      label: "wet-area waterproofing",
    },
    tags: ["Walk-in Shower", "Linear Drain", "Waterproofing"],
    wip: true,
  },
  {
    id: "fluted-terracotta-splashback",
    title: "Kitchen Splashback — Fluted Terracotta, Corner Return",
    image: splashbackFlutedImg,
    alt: "Terracotta fluted tile kitchen splashback wrapping a corner return, with ribs aligned across the join",
    description:
      "Fluted terracotta tile wrapping an internal corner with the ribs aligned across the join — the detail that separates a splashback that looks right from one that looks almost right. Setting out started from the corner and worked outward so the alignment landed where the eye goes first.",
    service: {
      href: "/services/kitchen-tiling",
      label: "kitchen tiling & splashbacks",
    },
    tags: ["Kitchen Splashback", "Fluted Tile", "Terracotta", "Corner Return"],
    wip: true,
  },
  {
    id: "white-gloss-shower",
    title: "Shower — White Gloss Wall Tile, Stainless Drain",
    image: whiteGlossImg,
    alt: "Shower with white gloss wall tiles, dark floor tiles and a stainless linear drain",
    description:
      "White gloss wall tile against a dark floor, with a stainless linear drain. Gloss tile reflects everything, so any lippage between tiles catches the light and shows — a levelling system was used across the full wall to keep every tile flush with its neighbour.",
    service: { href: "/services/bathroom-tiling", label: "shower tiling" },
    tags: ["Shower Tiling", "Gloss Tile", "Linear Drain", "Contrast Floor"],
    wip: true,
  },
  {
    id: "patterned-window-seat",
    title: "Window Seat — Monochrome Patterned Tile",
    image: windowSeatImg,
    alt: "Window seat finished in monochrome patterned tiles, laid to a bush outlook",
    description:
      "A window seat finished in monochrome patterned tile, laid to a bush outlook. Patterned tile has to be set out as a whole before anything is fixed — the pattern needs to resolve at the edges rather than being cut off mid-motif, and on a seat every edge is visible from every angle.",
    service: {
      href: "/services/floor-tiling",
      label: "floor & feature tiling",
    },
    tags: ["Feature Tiling", "Patterned Tile", "Monochrome", "Detail Work"],
    wip: false,
  },
  {
    id: "stone-look-floor-feature",
    title: "Stone-look floor and patterned feature strip",
    image: floorFeatureImg,
    alt: "Stone-look porcelain bathroom floor and wall tiles, with a patterned strip below the window, during installation",
    description:
      "Stone-look porcelain tiles across the floor and walls, with a patterned strip below the window. The photograph shows the floor layout, wall junctions and feature strip while installation was under way.",
    service: { href: "/services/floor-tiling", label: "floor tiling" },
    tags: ["Floor Tiling", "Porcelain", "Feature Strip"],
    wip: true,
  },
  {
    id: "subway-splashback",
    title: "White subway tiles around the kitchen windows",
    image: subwayImg,
    alt: "White subway tile splashback extending from the benchtop around the kitchen windows, during installation",
    description:
      "White subway tiles run above the benchtop and around two kitchen windows. The horizontal courses continue across the corner. The kitchen fittings were still being completed when this photograph was taken.",
    service: {
      href: "/services/kitchen-tiling",
      label: "kitchen tiling and splashbacks",
    },
    tags: ["Kitchen Splashback", "Subway Tile", "Window Returns"],
    wip: true,
  },
];
const groupFor = (href: string) =>
  href.endsWith("kitchen-tiling")
    ? "kitchens"
    : href.endsWith("floor-tiling")
      ? "floors"
      : "bathrooms";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    title="Our Tiling Portfolio"
    subtitle="Recent projects photographed on site — ensuites, walk-in showers, splashbacks and feature tiling, from ROH Tiling."
  />

  <!-- Portfolio Grid -->
  <section class="section">
    <div class="container">
      <!-- h2 required so the project h3s do not skip a heading level after the page h1 -->
      <h2 class="section-title">Tiling projects</h2>
      <div
        class="portfolio-filters"
        role="group"
        aria-label="Filter work by service"
        hidden
      >
        <button
          type="button"
          data-work-filter="all"
          aria-pressed="true"
          aria-controls="work-entries"
        >
          All work
        </button>
        <button
          type="button"
          data-work-filter="bathrooms"
          aria-pressed="false"
          aria-controls="work-entries"
        >
          Bathrooms
        </button>
        <button
          type="button"
          data-work-filter="kitchens"
          aria-pressed="false"
          aria-controls="work-entries"
        >
          Kitchens
        </button>
        <button
          type="button"
          data-work-filter="floors"
          aria-pressed="false"
          aria-controls="work-entries"
        >
          Floors and features
        </button>
      </div>
      <p
        class="portfolio-filter-status"
        role="status"
        aria-live="polite"
        hidden
      ></p>
      <div class="portfolio-grid" id="work-entries">
        {projects.map((project) => (
          <article
            class="portfolio-item"
            id={project.id}
            data-project-group={groupFor(project.service.href)}
          >
            <Image
              src={project.image}
              alt={project.alt}
              width={640}
              widths={[320, 480, 640]}
              sizes="(min-width: 768px) 46vw, 92vw"
              quality={70}
              format="webp"
              loading="lazy"
              decoding="async"
            />
            <div class="portfolio-item-content">
              <h3>{project.title}</h3>
              {project.wip && (
                <p class="portfolio-wip">
                  Photographed mid-installation — the surrounding trades had not
                  finished at this stage.
                </p>
              )}
              <p>{project.description}</p>
              <p class="portfolio-service-link">
                <a href={project.service.href}>
                  See our {project.service.label} service
                </a>
              </p>
              <p>
                <a
                  class="text-link"
                  href={quotePath(
                    project.service.href.split("/").pop() as ServiceId,
                  )}
                >
                  Discuss a similar job
                </a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO Content Section -->
  <section class="section section--light">
    <div class="container">
      <div class="portfolio-seo fade-in-up">
        <h2 class="section-title">The work behind the finish</h2>
        <p>
          These ROH photographs show finished work and work during installation.
          Look at the tile layout, the corners and the way the pattern meets its
          edges. A photograph of the finish cannot verify the hidden
          waterproofing or substrate.
        </p>
        <p>
          Planning a similar space? Read about{" "}
          <a href="/services/waterproofing">wet-area preparation</a>,{" "}
          <a href="/services/bathroom-tiling">bathroom and shower tiling</a>,{" "}
          <a href="/services/kitchen-tiling">kitchen splashbacks</a> or{" "}
          <a href="/services/floor-tiling">floor tiling</a>, or check the{" "}
          <a href="/service-areas">Wellington suburbs we cover</a> and get in
          touch for a free quote.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection />
</BaseLayout>

<script>
  const controls = document.querySelector<HTMLElement>(".portfolio-filters");
  const status = document.querySelector<HTMLElement>(
    ".portfolio-filter-status",
  );
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-work-filter]"),
  ];
  const entries = [
    ...document.querySelectorAll<HTMLElement>("[data-project-group]"),
  ];
  const services: Record<string, string> = {
    bathrooms: "bathroom-tiling",
    kitchens: "kitchen-tiling",
    floors: "floor-tiling",
  };
  function select(group: string, updateUrl = false) {
    const valid = buttons.some((button) => button.dataset.workFilter === group)
      ? group
      : "all";
    for (const entry of entries)
      entry.hidden = valid !== "all" && entry.dataset.projectGroup !== valid;
    for (const button of buttons)
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.workFilter === valid),
      );
    if (status)
      status.textContent = `${entries.filter((entry) => !entry.hidden).length} photos shown`;
    if (updateUrl) {
      const url = new URL(location.href);
      if (valid === "all") url.searchParams.delete("service");
      else url.searchParams.set("service", services[valid]);
      url.hash = "";
      history.replaceState(null, "", url);
    }
  }
  function showLinkedProject() {
    let id = "";
    try {
      id = decodeURIComponent(location.hash.slice(1));
    } catch {
      return;
    }
    const entry = entries.find((item) => item.id === id);
    if (entry) {
      select(entry.dataset.projectGroup || "all");
      requestAnimationFrame(() =>
        entry.scrollIntoView({ block: "start", behavior: "instant" }),
      );
    }
  }
  if (controls && status) {
    controls.hidden = false;
    status.hidden = false;
    const requested = new URLSearchParams(location.search).get("service");
    select(
      Object.keys(services).find((group) => services[group] === requested) ||
        "all",
    );
    showLinkedProject();
    buttons.forEach((button) =>
      button.addEventListener("click", () =>
        select(button.dataset.workFilter || "all", true),
      ),
    );
    window.addEventListener("hashchange", showLinkedProject);
  }
</script>
