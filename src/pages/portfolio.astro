---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';

const title = "Tiling Portfolio Wellington | ROH Tiling";
const description = "View our portfolio of completed tiling projects across Wellington. Bathroom renovations, shower tiling, commercial work & more. See the quality for yourself.";
const canonical = "/portfolio";
const breadcrumbs = [{ name: "Home", url: "/" }, { name: "Portfolio" }];

import JobPhoto from '../components/JobPhoto.astro';

import tealBathroom from '../assets/images/bathroom-teal-vertical-tile.jpg';
import showerDrain from '../assets/images/shower-floor-fall-to-drain.jpg';
import showerCorner from '../assets/images/shower-large-format-corner.jpg';
import commercialWall from '../assets/images/commercial-changing-room-feature-wall.jpg';
import marbleFloor from '../assets/images/floor-marble-look-large-format.jpg';

// Alt text describes the work and claims no suburb, because the job locations
// are not recorded. Do not add one without confirming it.
const projects = [
  {
    title: "Designer Bathroom, Teal Vertical Tile",
    image: tealBathroom,
    ratio: "3 / 4",
    alt: "Teal vertical subway tile bathroom with terrazzo floor, wall-hung timber vanity and skylight, installed by ROH Tiling",
    description: "Floor-to-ceiling teal vertical tile run against a terrazzo-look floor, with a skylight above picking up the glazed finish. Vertical setout is less forgiving than a standard brick bond: every course has to hold plumb across the wall and turn the internal corner without the joint drifting. The tiling wraps the shower area and the vanity wall as one continuous surface.",
    tags: ["Bathroom Tiling", "Vertical Subway", "Terrazzo Floor", "Feature Wall"],
  },
  {
    title: "Shower Floor, Fall to Central Drain",
    image: showerDrain,
    ratio: "2 / 3",
    alt: "Large-format tiled shower floor with a mitred fall to a central square drain, installed by ROH Tiling",
    description: "Large-format porcelain cut and laid to fall evenly toward a central square drain. Getting a large tile to drain properly means cutting the fall into the tile itself rather than relying on the screed alone, so the water runs to the waste from every direction instead of sitting in the low corner. Waterproofing sits under the whole floor and turns up the walls.",
    tags: ["Shower Tiling", "Falls to Drain", "Large-Format", "Waterproofing"],
  },
  {
    title: "Walk-in Shower, Large-Format Corner",
    image: showerCorner,
    ratio: "4 / 5",
    alt: "Large-format stone-look tiled shower corner cut neatly around a frosted privacy window, installed by ROH Tiling",
    description: "Stone-look porcelain in a large format to keep grout lines to a minimum. The tiling is cut around the frosted privacy window so the reveal is square and the joint sits tight to the frame, and the horizontal courses carry through the corner without stepping.",
    tags: ["Shower Tiling", "Stone Look", "Large-Format", "Porcelain"],
  },
  {
    title: "Commercial Fitout, Geometric Feature Wall",
    image: commercialWall,
    quality: 48,
    ratio: "16 / 9",
    alt: "Commercial changing room feature wall in a black and white diamond tile pattern beneath white subway tiling, installed by ROH Tiling",
    description: "A black and white diamond pattern running the full length of a changing room, with plain white subway above. Patterned work over a long run is a setout job before it is a tiling job: the repeat has to stay true from one end of the wall to the other, and the pattern has to land sensibly where the bench brackets and fixings interrupt it.",
    tags: ["Commercial Tiling", "Geometric Pattern", "Changing Room", "Feature Wall"],
  },
  {
    title: "Marble-Look Large-Format Floor",
    image: marbleFloor,
    ratio: "21 / 9",
    alt: "Marble-look large-format porcelain floor tiling with tight, consistent grout lines, installed by ROH Tiling",
    description: "Marble-look porcelain in a large format, laid tight with narrow grout lines so the veining reads across the floor rather than being chopped up by the joints. Large tile is unforgiving of an uneven substrate, so the floor is levelled and checked before any adhesive goes down.",
    tags: ["Floor Tiling", "Marble Look", "Large-Format", "Porcelain"],
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}>
  <PageHeader title="Our Tiling Portfolio" breadcrumbs={breadcrumbs} />

  <!-- Intro Section -->
  <section class="section section--light">
    <div class="container">
      <div class="portfolio-intro fade-in-up">
        <p>Explore a selection of our recent tiling projects across the Wellington region. From residential bathrooms to commercial spaces, every project reflects our commitment to precision, quality materials, and lasting craftsmanship.</p>
      </div>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="section">
    <div class="container">
      <div class="portfolio-grid">
        {projects.map((project) => (
          <article class="portfolio-item fade-in-up">
            <JobPhoto
              src={project.image}
              alt={project.alt}
              quality={project.quality}
              ratio={project.ratio}
              sizes="(min-width: 992px) 460px, (min-width: 600px) 46vw, 92vw"
              widths={[400, 640, 800]}
            />
            <div class="portfolio-item-content">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="portfolio-tags">
                {project.tags.map((tag) => (
                  <span class="portfolio-tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO Content Section -->
  <section class="section section--light">
    <div class="container">
      <div class="portfolio-seo fade-in-up">
        <h2 class="section-title">Wellington Tiling You Can Trust</h2>
        <p>Every project in our portfolio was completed by Rohullah Rassuli personally, right here in the Wellington region. From Whitby and Porirua through to Lower Hutt, Upper Hutt, and Wellington CBD, our work speaks for itself. We use only quality porcelain, ceramic, and natural stone tiles sourced from trusted New Zealand suppliers, paired with premium adhesives and grouts that ensure a lasting finish.</p>
        <p>Whether you are planning a simple bathroom refresh or a full-scale commercial fit-out, the same level of care and craftsmanship goes into every job. Precise cuts, consistent grout lines, correct waterproofing, and a clean, tidy workspace are standard on every ROH Tiling project. We invite you to browse these completed projects and see the quality for yourself — then get in touch for a free, no-obligation quote on your own tiling project.</p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection
    heading="Ready to Start Your Tiling Project?"
    text="Get in touch today for a free, no-obligation quote. We would love to add your project to our portfolio."
  />
</BaseLayout>

<style>
  .portfolio-intro {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .portfolio-intro p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text, #333);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .portfolio-item {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .portfolio-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .portfolio-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    display: block;
  }

  .portfolio-item-content {
    padding: 1.5rem;
  }

  .portfolio-item-content h3 {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    color: var(--color-heading, #1a1a2e);
  }

  .portfolio-item-content p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text, #555);
  }

  .portfolio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .portfolio-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    border-radius: 999px;
    background: #fdf4e3;
    color: #8b6914;
  }

  .portfolio-seo {
    max-width: 800px;
    margin: 0 auto;
  }

  .portfolio-seo p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text, #555);
    margin-bottom: 1rem;
  }
</style>
