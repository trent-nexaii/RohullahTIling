---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import Photo from '../components/Photo.astro';
import { business } from '../data/business';

import tealShower from '../assets/photos/teal-vertical-tile-shower.jpg';
import showerFloor from '../assets/photos/large-format-shower-floor.jpg';
import showerWindow from '../assets/photos/large-format-shower-window.jpg';
import commercialWall from '../assets/photos/commercial-geometric-wall.jpg';

const title = 'Tiling Portfolio Wellington | ROH Tiling';
const description =
  'Photographs of completed tiling work across Wellington: bathrooms, showers, tiled floors and commercial fitouts. See the finish before you commit.';
const canonical = '/portfolio';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Portfolio' }];

/**
 * Every project here is work Rohullah did. No stock photography, and no
 * suburb named unless it is known to be true, which is why these entries
 * describe the work rather than claiming a location.
 */
const projects = [
  {
    title: 'Designer Bathroom — Teal Vertical Tile',
    src: tealShower,
    alt: `Teal vertical subway tile shower with terrazzo floor and wall-hung vanity, installed by ${business.name}`,
    position: 'center 55%',
    description:
      'A floor-to-ceiling run of teal vertical subway tile, kept dead plumb across the wall and through the internal corner so the ribbing reads as one surface. Terrazzo-look floor tiles run out from under the wall-hung vanity with no break at the threshold, and the skylight above throws raking light across the glaze, which is unforgiving of any tile sitting proud of its neighbour.',
    tags: ['Bathroom Tiling', 'Vertical Subway', 'Terrazzo Floor', 'Wall-hung Vanity'],
  },
  {
    title: 'Shower Floor — Large-Format Porcelain Laid to Fall',
    src: showerFloor,
    alt: `Large-format tiled shower floor laid to fall towards a square waste outlet, installed by ${business.name}`,
    position: 'center 65%',
    description:
      'Large-format porcelain taken across the walls and down onto the shower floor, with the falls set so water runs to the square waste from every point in the enclosure rather than pooling at the low corner. The mixer and outlet penetrations are cut cleanly rather than packed with grout, and the wall-to-floor junction is sealed as a movement joint.',
    tags: ['Shower Tiling', 'Large-Format', 'Falls to Waste', 'Porcelain'],
  },
  {
    title: 'Bathroom Walls — Cut Around a Window Reveal',
    src: showerWindow,
    alt: `Large-format wall tiles cut around a bathroom window reveal, installed by ${business.name}`,
    position: 'center 40%',
    description:
      'The same large-format tile carried around a window opening, with the cuts sized so the tile returns into the reveal and lands square against the frame on all four sides. Large tiles leave very few grout lines to hide behind, so the set-out has to be right before the first sheet is fixed rather than corrected as the wall goes up.',
    tags: ['Wall Tiling', 'Window Reveal', 'Large-Format', 'Precision Cuts'],
  },
  {
    title: 'Commercial Fitout — Geometric Feature Wall',
    src: commercialWall,
    alt: `Commercial feature wall in a black and white geometric diamond pattern with a suspended ceiling above, installed by ${business.name}`,
    position: 'center',
    description:
      'A geometric diamond pattern set out across a long commercial elevation, with a banded white field above it. On a run this length a small error in the first course compounds into a visible drift by the far end, so the pattern was set out and checked against the datum as the work moved along the wall.',
    tags: ['Commercial Tiling', 'Geometric Pattern', 'Feature Wall', 'Fitout'],
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}>
  <PageHeader title="Our Tiling Portfolio" breadcrumbs={breadcrumbs} />

  <!-- Intro Section -->
  <section class="section section--light">
    <div class="container">
      <div class="portfolio-intro fade-in-up">
        <p>A selection of recent tiling work across the Wellington region, from residential bathrooms through to commercial fitouts. These are photographs of jobs as they were handed over.</p>
      </div>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="section">
    <div class="container">
      <div class="portfolio-grid">
        {projects.map((project) => (
          <article class="portfolio-item fade-in-up">
            <Photo
              src={project.src}
              alt={project.alt}
              ratio="4 / 3"
              position={project.position}
              sizes="(min-width: 768px) 50vw, 100vw"
              widths={[400, 600, 900]}
              class="portfolio-item__photo"
            />
            <div class="portfolio-item-content">
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              <div class="portfolio-tags">
                {project.tags.map((tag) => (
                  <span class="portfolio-tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO Content Section -->
  <section class="section section--light">
    <div class="container">
      <div class="portfolio-seo fade-in-up">
        <h2 class="section-title">Wellington Tiling You Can Trust</h2>
        <p>Every project on this page was tiled by {business.owner} personally, here in the Wellington region. From Whitby and Porirua through to Lower Hutt, Upper Hutt and Wellington City, the work is the reference rather than the sales pitch.</p>
        <p>Whether it is a single bathroom or a full commercial fitout, the same things decide whether it lasts: the substrate prepared properly, wet areas waterproofed before tiling, falls set so water goes where it should, and cuts made rather than fudged. Have a look through these projects, then get in touch for a free, no-obligation quote on your own job.</p>
      </div>
    </div>
  </section>

  <CTASection
    heading="Want Work Like This in Your Place?"
    text="Get in touch for a free, no-obligation quote anywhere across the Wellington region."
  />
</BaseLayout>

<style>
  .portfolio-intro {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .portfolio-intro p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-body-text, #333);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .portfolio-item {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .portfolio-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .portfolio-item :global(.portfolio-item__photo img) {
    border-radius: 8px 8px 0 0;
  }

  .portfolio-item-content {
    padding: 1.5rem;
  }

  .portfolio-item-content h2 {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    color: var(--color-dark-text, #1a1a1a);
  }

  .portfolio-item-content p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-body-text, #555);
  }

  .portfolio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .portfolio-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    border-radius: 999px;
    background: #fdf4e3;
    color: #8b6914;
  }

  .portfolio-seo {
    max-width: 800px;
    margin: 0 auto;
  }

  .portfolio-seo p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-body-text, #555);
    margin-bottom: 1rem;
  }
</style>
