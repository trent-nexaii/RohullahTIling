---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import { Image } from 'astro:assets';
import { OWNER_NAME } from '../data/business';

import ensuiteImg from '../assets/images/ensuite-large-format-porcelain-tiling-wellington.webp';
import showerTealImg from '../assets/images/shower-tiling-vertical-stack-teal-tile-wellington.webp';
import splashbackFlutedImg from '../assets/images/kitchen-splashback-fluted-terracotta-tile-wellington.webp';
import walkInShowerImg from '../assets/images/walk-in-shower-tiling-linear-drain-wellington.webp';
import whiteGlossImg from '../assets/images/shower-tiling-white-gloss-wall-tile-wellington.webp';
import floorFeatureImg from '../assets/images/bathroom-floor-tiling-feature-strip-wellington.webp';
import windowSeatImg from '../assets/images/patterned-tile-window-seat-wellington.webp';

import greenNicheImg from '../assets/images/sage-green-shower-niche-progress.jpg';
import charcoalShowerImg from '../assets/images/charcoal-shower-floor-progress.jpg';
import botanicalBathroomImg from '../assets/images/botanical-bathroom-tiling-progress.jpg';

const title = "Tiling Portfolio Wellington | ROH Tiling";
const description = "Recent tiling projects across Wellington by ROH Tiling. Ensuites, walk-in showers, kitchen splashbacks and feature tiling — photographed on site.";
const canonical = "/portfolio";
const breadcrumbs = [{ name: "Home", url: "/" }, { name: "Portfolio" }];

/**
 * Every project links to the service page it belongs to.
 * `wip` marks work-in-progress shots so the caption frames them honestly —
 * green gib and unfitted joinery read as proof of process, not sloppiness.
 */
const projects = [
  {
    id: "ensuite-large-format-porcelain",
    title: "Ensuite — Large-Format Porcelain, Frameless Shower",
    image: ensuiteImg,
    alt: "Finished ensuite with large-format grey porcelain wall tiles, frameless glass shower and wall-hung basin, tiled by ROH Tiling in Wellington",
    description: "A completed ensuite finished in large-format grey porcelain, run floor to ceiling to keep grout lines to a minimum. The frameless glass shower meets the tiled wall with a clean silicone junction, and the wall-hung basin required precise cuts around the mixer and waste penetrations. Large-format tile is unforgiving — the substrate has to be flat before a single sheet goes up.",
    service: { href: "/services/bathroom-tiling", label: "bathroom & ensuite tiling" },
    tags: ["Bathroom Tiling", "Large-Format Porcelain", "Ensuite", "Frameless Shower"],
    wip: false,
  },
  {
    id: "teal-stack-bond-shower",
    title: "Walk-in Shower — Teal Vertical Stack Bond",
    image: showerTealImg,
    alt: "Walk-in shower with teal vertical stack-bond wall tiles, dark large-format floor tiles and a linear drain, under a skylight",
    description: "Teal wall tiles laid in a vertical stack bond, which is the least forgiving layout there is — every joint runs dead straight top to bottom, so any drift in the first course shows all the way up. Dark large-format floor tiles are set to fall toward a linear drain, under a skylight that shows up every grout line.",
    service: { href: "/services/bathroom-tiling", label: "shower & bathroom tiling" },
    tags: ["Shower Tiling", "Stack Bond", "Linear Drain", "Feature Colour"],
    wip: true,
  },
  {
    id: "walk-in-shower-linear-drain",
    title: "Walk-in Shower — Tiled Hob and Linear Drain",
    image: walkInShowerImg,
    alt: "Walk-in shower with grey large-format tiles, tiled hob and linear drain set to fall",
    description: "Grey large-format tiles over a tiled hob, with the floor set to fall evenly into a linear drain. The falls and the waterproofing underneath are the part of this job nobody ever sees — and the part that determines whether the bathroom is still sound in fifteen years. Membrane and band reinforcement went in to NZS 4858 before any tile was laid.",
    service: { href: "/services/waterproofing", label: "wet-area waterproofing" },
    tags: ["Walk-in Shower", "Linear Drain", "Waterproofing", "NZS 4858"],
    wip: true,
  },
  {
    id: "fluted-terracotta-splashback",
    title: "Kitchen Splashback — Fluted Terracotta, Corner Return",
    image: splashbackFlutedImg,
    alt: "Terracotta fluted tile kitchen splashback wrapping a corner return, with ribs aligned across the join",
    description: "Fluted terracotta tile wrapping an internal corner with the ribs aligned across the join — the detail that separates a splashback that looks right from one that looks almost right. Setting out started from the corner and worked outward so the alignment landed where the eye goes first.",
    service: { href: "/services/kitchen-tiling", label: "kitchen tiling & splashbacks" },
    tags: ["Kitchen Splashback", "Fluted Tile", "Terracotta", "Corner Return"],
    wip: true,
  },
  {
    id: "white-gloss-shower",
    title: "Shower — White Gloss Wall Tile, Stainless Drain",
    image: whiteGlossImg,
    alt: "Shower with white gloss wall tiles, dark floor tiles and a stainless linear drain",
    description: "White gloss wall tile against a dark floor, with a stainless linear drain. Gloss tile reflects everything, so any lippage between tiles catches the light and shows — a levelling system was used across the full wall to keep every tile flush with its neighbour.",
    service: { href: "/services/bathroom-tiling", label: "shower tiling" },
    tags: ["Shower Tiling", "Gloss Tile", "Linear Drain", "Contrast Floor"],
    wip: true,
  },
  {
    id: "green-shower-niche",
    title: "Shower — Green Vertical Tiles & Recessed Niche",
    image: greenNicheImg,
    alt: "Glossy green vertical shower tiles and a recessed niche, photographed before plumbing and electrical fittings were installed",
    description: "Glossy green tiles run vertically across the shower walls and into a recessed niche. Light-coloured floor tiles meet a linear drain. The photograph records the installation before the fittings and surrounding work were finished.",
    service: { href: "/services/bathroom-tiling", label: "bathroom and shower tiling" },
    tags: ["Shower Tiling", "Vertical Layout", "Recessed Niche"],
    wip: true,
  },
  {
    id: "charcoal-shower-floor",
    title: "Shower — Charcoal Tiles & Cut Floor Layout",
    image: charcoalShowerImg,
    position: "center bottom",
    alt: "Charcoal shower wall and floor tiles cut around a square drain, with capped plumbing points awaiting fittings",
    description: "Large charcoal tiles continue from the shower walls onto the floor, with angled cuts around a square drain. The dark finish contrasts with the surrounding light walls. Photographed before the shower fittings were installed.",
    service: { href: "/services/bathroom-tiling", label: "bathroom and shower tiling" },
    tags: ["Shower Tiling", "Charcoal Tiles", "Floor Layout"],
    wip: true,
  },
  {
    id: "botanical-bathroom-floor",
    title: "Bathroom — Light Tiles & Botanical Feature Wall",
    image: botanicalBathroomImg,
    position: "center bottom",
    alt: "Light bathroom wall and floor tiles alongside a botanical feature wall, with levelling clips and installation tools still present",
    description: "Light-coloured wall and floor tiles sit alongside a botanical feature wall. Floor cuts meet a central drain. Levelling clips and tools remain visible, with fittings and ceiling work still to be completed at the time of the photograph.",
    service: { href: "/services/floor-tiling", label: "floor tiling and preparation" },
    tags: ["Floor Tiling", "Bathroom Tiling", "Installation Detail"],
    wip: true,
  },
  {
    id: "bathroom-floor-feature-strip",
    title: "Bathroom Floor — Stone-Look Tiles & Patterned Feature Strip",
    image: floorFeatureImg,
    alt: "Light stone-look bathroom floor and wall tiles with a patterned feature strip, photographed before fittings and renovation work were finished",
    description: "Light stone-look tiles continue from the floor onto the walls, with a narrow patterned strip below the window. Photographed during renovation, before the fixtures and surrounding work were finished.",
    service: { href: "/services/floor-tiling", label: "floor tiling and preparation" },
    tags: ["Floor Tiling", "Bathroom Tiling", "Patterned Feature Strip"],
    wip: true,
  },
  {
    id: "patterned-window-seat",
    title: "Window Seat — Monochrome Patterned Tile",
    image: windowSeatImg,
    alt: "Window seat finished in monochrome patterned tiles, laid to a bush outlook",
    description: "A window seat finished in monochrome patterned tile, laid to a bush outlook. Patterned tile has to be set out as a whole before anything is fixed — the pattern needs to resolve at the edges rather than being cut off mid-motif, and on a seat every edge is visible from every angle.",
    service: { href: "/services/floor-tiling", label: "floor & feature tiling" },
    tags: ["Feature Tiling", "Patterned Tile", "Monochrome", "Detail Work"],
    wip: false,
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}>
  <PageHeader
    title="Our Tiling Portfolio"
    subtitle="Recent projects photographed on site — ensuites, walk-in showers, splashbacks and feature tiling, tiled by Rohullah Rassuli personally."
  />

  <!-- Intro Section -->
  <section class="section section--light">
    <div class="container">
      <div class="portfolio-intro fade-in-up">
        <p>Explore a selection of our recent tiling projects across the Wellington region. From residential bathrooms to commercial spaces, every project reflects our commitment to precision, quality materials, and lasting craftsmanship.</p>
      </div>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="section">
    <div class="container">
      <!-- h2 required so the project h3s do not skip a heading level after the page h1 -->
      <h2 class="section-title">Recent Tiling Projects Across Wellington</h2>
      <div class="portfolio-grid">
        {projects.map((project) => (
          <article class="portfolio-item fade-in-up" id={project.id}>
            <Image
              src={project.image}
              alt={project.alt}
              style={project.position ? `object-position: ${project.position}` : undefined}
              width={640}
              widths={[320, 480, 640]}
              sizes="(min-width: 768px) 46vw, 92vw"
              quality={70}
              format="webp"
              loading="lazy"
              decoding="async"
            />
            <div class="portfolio-item-content">
              <h3>{project.title}</h3>
              {project.wip && (
                <p class="portfolio-wip">Photographed mid-installation — the surrounding trades had not finished at this stage.</p>
              )}
              <p>{project.description}</p>
              <p class="portfolio-service-link">
                <a href={project.service.href}>See our {project.service.label} service</a>
              </p>
              <p><a href="/contact#quote-form">Discuss a similar tiling project →</a></p>
              <div class="portfolio-tags">
                {project.tags.map((tag) => (
                  <span class="portfolio-tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO Content Section -->
  <section class="section section--light">
    <div class="container">
      <div class="portfolio-seo fade-in-up">
        <h2 class="section-title">Wellington Tiling You Can Trust</h2>
        <p>Every project on this page was tiled by {OWNER_NAME} personally, right here in the Wellington region. Several are photographed mid-installation, before the surrounding trades finished — that is deliberate. It shows the substrate prep, the falls, the setting out and the waterproofing that a styled photograph taken after handover would hide.</p>
        <p>Whether you are planning a simple bathroom refresh or a full renovation, the same care goes into every job: precise cuts, consistent grout lines, correct <a href="/services/waterproofing">wet-area waterproofing</a>, and a clean workspace at the end of each day. Browse the projects above, then read more about <a href="/services/bathroom-tiling">bathroom and shower tiling</a>, <a href="/services/kitchen-tiling">kitchen splashbacks</a> or <a href="/services/floor-tiling">floor tiling</a> — or check the <a href="/service-areas">Wellington suburbs we cover</a> and get in touch for a free quote.</p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection
    heading="Ready to Start Your Tiling Project?"
    text="Get in touch today for a free, no-obligation quote. We would love to add your project to our portfolio."
  />
</BaseLayout>

<style>
  .portfolio-intro {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .portfolio-intro p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text, #333);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .portfolio-item {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .portfolio-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .portfolio-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    display: block;
  }

  .portfolio-wip {
    font-size: 0.85rem !important;
    font-style: italic;
    color: var(--color-muted, #777) !important;
    margin-bottom: 0.75rem !important;
  }

  .portfolio-service-link {
    margin-bottom: 1rem !important;
    font-size: 0.92rem !important;
    font-weight: 600;
  }

  .portfolio-service-link a {
    color: var(--color-link-gold, #946A09);
  }

  .portfolio-item-content {
    padding: 1.5rem;
  }

  .portfolio-item-content h3 {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    color: var(--color-heading, #1a1a2e);
  }

  .portfolio-item-content p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text, #555);
  }

  .portfolio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .portfolio-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    border-radius: 999px;
    background: #fdf4e3;
    color: #8b6914;
  }

  .portfolio-seo {
    max-width: 800px;
    margin: 0 auto;
  }

  .portfolio-seo p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text, #555);
    margin-bottom: 1rem;
  }
</style>
