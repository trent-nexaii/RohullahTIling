---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { PHONE_DISPLAY, PHONE_E164, OWNER_NAME } from '../data/business';
import ensuite from '../assets/images/ensuite-large-format-porcelain-tiling-wellington.webp';
import corner from '../assets/images/kitchen-splashback-fluted-terracotta-tile-wellington.webp';
import teal from '../assets/images/shower-tiling-vertical-stack-teal-tile-wellington.webp';
import seat from '../assets/images/patterned-tile-window-seat-wellington.webp';
import roh from '../assets/images/rohullah-rassuli-tiler-wellington.webp';
const services = [
  ['Bathroom tiling', '/services/bathroom-tiling', 'Showers, walls and floors.'],
  ['Kitchen tiling', '/services/kitchen-tiling', 'Splashbacks and corner returns.'],
  ['Floor tiling', '/services/floor-tiling', 'Porcelain, ceramic and natural stone.'],
  ['Waterproofing', '/services/waterproofing', 'Preparation beneath wet-area tiles.'],
  ['Underfloor heating', '/services/underfloor-heating', 'Electric heating beneath tiled floors.'],
  ['Tile repairs', '/services/tile-repairs', 'Replacement tiles, grout and silicone.'],
];
---
<BaseLayout
  title="Wellington Tiler | Bathroom, Kitchen & Floor Tiling | ROH Tiling"
  description="Wellington's trusted professional tiler. Expert bathroom, kitchen & floor tiling across the Wellington region. Free quotes. Call 021 026 02044 today."
  canonical="/"
>
  <section class="home-opening container">
    <h1>Wellington Tiler — Bathrooms, Splashbacks and Floors</h1>
    <div class="opening-layout">
      <div class="opening-copy">
        <p>I'm Rohullah. I quote the job, prepare the surface and lay every tile myself.</p>
        <p>Based in Whitby, working across the Wellington region.</p>
        <a class="btn btn-primary" href="/contact">Talk to me about your job</a>
        <a class="phone-text" href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a>
      </div>
      <figure class="opening-photo">
        <Image src={ensuite} alt="Finished ensuite with large-format porcelain walls, frameless shower and wall-hung basin, tiled by ROH Tiling" width={1280} widths={[480, 800, 1280, 1600]} sizes="(min-width: 900px) 70vw, 92vw" quality={80} format="webp" loading="eager" fetchpriority="high" />
        <figcaption>Porcelain ensuite. Finished work, photographed on site.</figcaption>
      </figure>
    </div>
  </section>

  <section class="work-story container" aria-labelledby="work-heading">
    <div class="work-intro">
      <h2 id="work-heading">Look at the joins.</h2>
      <p>The cut at a corner. The line under a skylight. The way a pattern meets its edge. Here is a closer look at my work.</p>
    </div>
    <div class="project-pair">
      <figure class="project-print project-print--wide">
        <a href="/portfolio#teal-stack-bond-shower"><Image src={teal} alt="Teal vertical stack-bond shower tiling under a skylight, during installation" width={900} widths={[420, 650, 900]} sizes="(min-width: 900px) 52vw, 92vw" quality={78} format="webp" loading="lazy" /></a>
        <figcaption>
          <h3>Stack-bond shower</h3>
          <p>Every vertical joint runs from the first course to the last. Work in progress.</p>
          <details class="work-note"><summary>Look at the setting out</summary><p>The skylight shows up every grout line. The dark floor tiles are set to fall towards the linear drain.</p><a href="/portfolio#teal-stack-bond-shower">Read the project notes</a></details>
        </figcaption>
      </figure>
      <figure class="project-print project-print--narrow">
        <a href="/portfolio#fluted-terracotta-splashback"><Image src={corner} alt="Terracotta fluted splashback with ribs aligned around an internal corner, work in progress" width={700} widths={[350, 500, 700]} sizes="(min-width: 900px) 34vw, 78vw" quality={78} format="webp" loading="lazy" /></a>
        <figcaption>
          <h3>A fluted corner return</h3>
          <p>The ribs carry around the join. Work in progress.</p>
          <details class="work-note"><summary>Look at the setting out</summary><p>Setting out started at the internal corner and worked outward so the ribs met where the eye goes first.</p><a href="/portfolio#fluted-terracotta-splashback">Read the project notes</a></details>
        </figcaption>
      </figure>
    </div>
    <div class="feature-print">
      <figure><a href="/portfolio#patterned-window-seat"><Image src={seat} alt="Monochrome patterned tiles on a window seat with a bush outlook" width={1100} widths={[420, 750, 1100]} sizes="(min-width: 900px) 62vw, 92vw" quality={78} format="webp" loading="lazy" /></a><figcaption>A patterned window seat. Setting out the whole pattern before fixing the tiles.</figcaption></figure>
      <a class="text-link" href="/portfolio">View the tiling portfolio</a>
    </div>
  </section>

  <section class="owner-story section section--light">
    <div class="container owner-layout">
      <figure><Image src={roh} alt={`${OWNER_NAME}, owner of ROH Tiling, on site in Wellington`} width={700} widths={[350, 500, 700]} sizes="(min-width: 900px) 35vw, 80vw" quality={78} format="webp" loading="lazy" /></figure>
      <div>
        <h2>Rohullah Rassuli.<br />On the tools.</h2>
        <p>I have been on the tools for over ten years, and I still lay every tile myself. When you call ROH Tiling you get me on the phone, me doing the quote, and me on site.</p>
        <p>Tiling is a trade where much of the work is hidden: the substrate preparation, the falls to the drain, the waterproofing.</p>
        <a class="text-link" href="/about">More about how I work</a>
      </div>
    </div>
  </section>

  <section class="section container job-list">
    <div class="job-list-intro"><h2>What needs tiling?</h2><p>A whole bathroom or a damaged tile. Start with the work you need.</p><p>Whitby, Porirua, Wellington City, Hutt Valley and Kapiti Coast. <a href="/service-areas">Check your location</a></p></div>
    <ul>{services.map(([name, href, note]) => <li><a href={href}><h3>{name}</h3><span aria-hidden="true">→</span></a><p>{note}</p></li>)}</ul>
  </section>

  <section class="contact-close section">
    <div class="container contact-close-layout"><h2>Tell me about<br />your tiling job.</h2><div><p>Send your location, what you want tiled, and any measurements you already have. I'll reply within 24 hours.</p><a class="btn btn-primary" href="/contact">Request a free quote</a><a class="phone-text" href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></div></div>
  </section>
</BaseLayout>
