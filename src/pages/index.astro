  .work-card:hover .work-card__link { text-decoration: underline; }

  /* Meet Rohullah band */
  .meet-section { background: var(--color-white); border-top: 1px solid var(--color-border-warm); }
  .meet-band {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .meet-band {
      grid-template-columns: 300px 1fr;
      gap: 3rem;
    }
  }
  .meet-band__figure {
    width: 100%;
    max-width: 300px;
    justify-self: center;
  }
  .meet-band__img {
    display: block;
    width: 100%;
