---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import { Image } from "astro:assets";
import { PHONE_DISPLAY, PHONE_E164, OWNER_NAME } from "../data/business";
import { services, servicePath } from "../data/services";
import ensuite from "../assets/images/ensuite-large-format-porcelain-tiling-wellington.webp";
import corner from "../assets/images/kitchen-splashback-fluted-terracotta-tile-wellington.webp";
import teal from "../assets/images/shower-tiling-vertical-stack-teal-tile-wellington.webp";
import roh from "../assets/images/rohullah-rassuli-tiler-wellington.webp";
---

<BaseLayout
  title="Wellington Tiler | ROH Tiling"
  description="Owner-operated tiling from Whitby, Porirua. Bathrooms, kitchen splashbacks and floors across Wellington. See Roh's work and request a free quote."
  canonical="/"
>
  <section class="home-opening">
    <div class="container opening-layout">
      <div class="opening-copy">
        <h1>Wellington Tiler — Bathrooms, Splashbacks and Floors</h1>
        <p>
          I'm Rohullah, the owner of ROH Tiling. Based in Whitby, Porirua, and
          working across the Wellington region.
        </p>
        <div class="opening-actions">
          <a class="btn btn-primary" href="/contact#quote-form">
            Request a quote
          </a>
          <a class="phone-text" href={`tel:${PHONE_E164}`}>
            {PHONE_DISPLAY}
          </a>
        </div>
        <p class="opening-note">
          Tell me what you have in mind. Free quotes, with a reply within 24
          hours.
        </p>
      </div>
      <figure class="opening-photo">
        <Image
          src={ensuite}
          alt="Finished ROH ensuite with large-format grey porcelain tiles, frameless shower and wall-hung basin"
          width={1000}
          widths={[420, 640, 900, 1200]}
          sizes="(min-width: 900px) 51vw, 100vw"
          quality={80}
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <span>Large-format porcelain ensuite</span>
          <a href="/portfolio#ensuite-large-format-porcelain">
            See the finished work
          </a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section container work-story" aria-labelledby="work-heading">
    <div class="work-intro">
      <h2 id="work-heading">Look at the setting out.</h2>
      <p>
        A line of grout beneath a skylight. Fluted tiles meeting at a corner.
        Look closely at the setting out in these ROH projects.
      </p>
    </div>
    <div class="project-pair">
      <figure class="project-print project-print--wide">
        <a href="/portfolio#teal-stack-bond-shower">
          <Image
            src={teal}
            alt="Teal vertical stack-bond shower tiles beneath a skylight, during installation"
            width={900}
            widths={[420, 650, 900]}
            sizes="(min-width: 900px) 52vw, 90vw"
            quality={78}
            format="webp"
            loading="lazy"
          />
        </a>
        <figcaption>
          <h3>Stack-bond shower</h3>
          <p>
            Vertical joints run from the first course to the last. Work in
            progress.
          </p>
          <details class="work-note">
            <summary>Look at the setting out</summary>
            <p>
              The skylight shows up the grout lines. Dark floor tiles are set to
              fall towards the linear drain.
            </p>
            <a href="/portfolio#teal-stack-bond-shower">
              Read the project notes
            </a>
          </details>
        </figcaption>
      </figure>
      <figure class="project-print project-print--narrow">
        <a href="/portfolio#fluted-terracotta-splashback">
          <Image
            src={corner}
            alt="Fluted terracotta kitchen splashback with ribs aligned around a corner, during installation"
            width={700}
            widths={[350, 500, 700]}
            sizes="(min-width: 900px) 33vw, 90vw"
            quality={78}
            format="webp"
            loading="lazy"
          />
        </a>
        <figcaption>
          <h3>A fluted corner return</h3>
          <p>The ribs carry around the join. Work in progress.</p>
          <details class="work-note">
            <summary>Look at the setting out</summary>
            <p>
              Setting out started at the internal corner and worked outward so
              the ribs met where the eye goes first.
            </p>
            <a href="/portfolio#fluted-terracotta-splashback">
              Read the project notes
            </a>
          </details>
        </figcaption>
      </figure>
    </div>
    <a class="text-link" href="/portfolio">
      View the tiling portfolio
    </a>
  </section>

  <section class="section section--white">
    <div class="container job-list">
      <div>
        <h2>What needs tiling?</h2>
        <p>
          Start with the space you want to work on. Each service explains the
          scope, what affects a quote and the details to send.
        </p>
        <a class="text-link" href="/services">
          Explore all tiling services
        </a>
      </div>
      <ul>
        {services.map((service) => (
          <li>
            <h3>
              <a href={servicePath(service.id)}>{service.name}</a>
            </h3>
            <p>{service.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section container owner-layout">
    <figure>
      <Image
        src={roh}
        alt={`${OWNER_NAME}, owner of ROH Tiling, on site`}
        width={650}
        widths={[350, 500, 650]}
        sizes="(min-width: 900px) 33vw, 90vw"
        quality={78}
        format="webp"
        loading="lazy"
      />
    </figure>
    <div>
      <h2>Meet Rohullah Rassuli.</h2>
      <p>
        ROH Tiling is an owner-operated business. Speak to Roh about the
        surface, the tile choice and how you want the finished room to feel.
      </p>
      <p>
        Based in Whitby, serving Porirua, Wellington City, the Hutt Valley and
        Kāpiti Coast. <a href="/service-areas">Check your location</a>.
      </p>
      <a class="text-link" href="/about">
        Meet Rohullah
      </a>
    </div>
  </section>
  <CTASection />
</BaseLayout>
