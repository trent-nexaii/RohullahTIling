  .meet-band__text p:last-child { margin-bottom: 0; }
</style>

<style>
  [data-hero-slide] {transition: opacity .65s ease, visibility .65s;}
  [data-hero-slide]:not(.is-active) {opacity:0; visibility:hidden;}
  .hero__img--deferred {position:absolute; inset:0; height:100%;}
  .hero__carousel-controls {position:absolute; z-index:3; inset:auto 0 0; padding:2rem 1rem .8rem 8%; background:linear-gradient(transparent,rgba(0,0,0,.9)); color:white; font-size:.8rem;}
  .hero__carousel-controls[hidden] {display:none;}
  /* Keep the completed seat's tiled surface clear of the photo overlay. */
  .hero__figure[data-current-slide="1"] .hero__carousel-controls {top:0;bottom:auto;padding-top:.8rem;padding-bottom:2rem;background:linear-gradient(rgba(0,0,0,.85),transparent);}
  .hero__carousel-caption {display:block; margin-bottom:.5rem;}
  .hero__carousel-buttons {display:flex; gap:.6rem; align-items:center; flex-wrap:wrap;}
  .hero__carousel-buttons button {font:inherit; color:white; background:#26221c; border:1px solid #c6b99b; border-radius:4px; min-height:44px; min-width:44px; padding:.4rem .65rem; cursor:pointer;}
  .hero__carousel-buttons button:focus-visible {outline:3px solid white; outline-offset:3px;}
  @media(prefers-reduced-motion:reduce) {[data-hero-slide] {transition:none;}}
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (carousel) {
    const slides = [...carousel.querySelectorAll<HTMLImageElement>('[data-hero-slide]')];
    const pause = carousel.querySelector<HTMLButtonElement>('[data-hero-pause]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0, requested = 0, paused = motion.matches, hovered = false, focused = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function schedule() {
      clearTimeout(timer);
      if (!paused && !hovered && !focused && !document.hidden) {
        timer = setTimeout(async () => {await show(current + 1); schedule();}, 5500);
      }
    }
    function label() {pause.textContent = paused ? 'Play slideshow' : 'Pause slideshow';}
    async function show(index: number, announce = false) {
      const next = (index + slides.length) % slides.length;
      const request = ++requested;
      const image = slides[next];
      if (!image.getAttribute('src')) {image.srcset = image.dataset.srcset!; image.src = image.dataset.src!;}
      try {await image.decode();} catch {return;}
      if (request !== requested) return;
      current = next;
      carousel!.dataset.currentSlide = String(current);
      slides.forEach((slide, i) => {slide.classList.toggle('is-active', i === current); slide.setAttribute('aria-hidden', String(i !== current));});
      carousel!.querySelector('[data-hero-position]')!.textContent = `${current+1} / ${slides.length}`;
      carousel!.querySelector('[data-hero-caption]')!.textContent = image.dataset.caption!;
      if (announce) carousel!.querySelector('[data-hero-announcement]')!.textContent = `Project ${current+1} of ${slides.length}: ${image.dataset.caption}`;
    }
    function manual(step: number) {paused = true; void show(current + step, true); label(); schedule();}
    carousel.querySelector('[data-hero-prev]')!.addEventListener('click', () => manual(-1));
    carousel.querySelector('[data-hero-next]')!.addEventListener('click', () => manual(1));
    pause.addEventListener('click', () => {paused = !paused; label(); schedule();});
    carousel.addEventListener('pointerenter', () => {hovered = true; schedule();});
    carousel.addEventListener('pointerleave', () => {hovered = false; schedule();});
    carousel.addEventListener('focusin', () => {focused = true; schedule();});
    carousel.addEventListener('focusout', () => {focused = false; schedule();});
    motion.addEventListener('change', () => {paused = motion.matches; label(); schedule();});
    document.addEventListener('visibilitychange', schedule);
    carousel.querySelector<HTMLElement>('.hero__carousel-controls')!.hidden = false;
    label(); schedule();
  }
</script>
