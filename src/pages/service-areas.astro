---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const title = "Wellington Tiling Service Areas | ROH Tiling";
const description = "Professional tiling services across Wellington — Whitby, Porirua, Lower Hutt, Upper Hutt, Kapiti Coast & more. Local tiler, free quotes. Call 021 026 02044.";
const canonical = "/service-areas";
const breadcrumbs = [{ name: "Home", url: "/" }, { name: "Service Areas" }];
// Retain the existing coverage list. A suburb here is not a claim of a photographed job there.
const regions = [
  { name: 'Northern Wellington & Porirua', places: ['Whitby (home base)', 'Papakowhai', 'Aotea', 'Porirua', 'Plimmerton', 'Pukerua Bay', 'Mana', 'Titahi Bay'] },
  { name: 'Central Wellington', places: ['Wellington CBD', 'Karori', 'Kelburn', 'Brooklyn', 'Newtown', 'Island Bay', 'Kilbirnie', 'Miramar', 'Hataitai', 'Roseneath'] },
  { name: 'Northern Suburbs', places: ['Johnsonville', 'Tawa', 'Churton Park'] },
  { name: 'Hutt Valley', places: ['Lower Hutt', 'Petone', 'Upper Hutt', 'Eastbourne'] },
  { name: 'Kapiti Coast', places: ['Paraparaumu', 'Waikanae', 'Raumati'] },
];
const regionIds = ['porirua', 'wellington-city', 'northern-suburbs', 'hutt-valley', 'kapiti-coast'];
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}>
  <PageHeader
    title="Tiling Services Across the Wellington Region"
    subtitle="Based in Whitby and working throughout Porirua, Wellington City, the Hutt Valley and the Kapiti Coast."
  />

  <section class="section">
    <div class="container">
      <div class="coverage-intro">
        <h2>Where Rohullah works</h2>
        <p>Find your suburb below, then <a href="/contact">send your location and project details</a> for a free quote. For the type of work you need, see <a href="/services">tiling services</a>.</p>
      </div>
      <nav class="coverage-jumps" aria-label="Find a service area">{regions.map((region, index) => <a href={`#${regionIds[index]}`}>{region.name}</a>)}</nav>
      <div class="coverage-directory">
        {regions.map((region, index) => (
          <section class="coverage-region" id={regionIds[index]} aria-label={region.name}>
            <h3>{region.name}</h3>
            <ul>{region.places.map((place) => <li>{place}</li>)}</ul>
            <a class="coverage-service-link" href="/services#core-services">Choose a tiling service</a>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container coverage-next">
      <div>
        <h2>Don't see your area?</h2>
        <p>Ask Rohullah whether your location can be covered before planning the work.</p>
      </div>
      <a href="/contact" class="btn btn-primary">Ask About Your Location</a>
    </div>
  </section>
</BaseLayout>

<style>
  .coverage-intro { display: grid; gap: 1rem; margin-bottom: 3rem; }
  .coverage-intro h2, .coverage-next h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .coverage-intro p { max-width: 62ch; }
  .coverage-intro a { color: var(--color-link-gold); text-decoration: underline; text-underline-offset: 0.2em; }
  .coverage-directory { display: grid; gap: 2.5rem 4rem; }
  .coverage-region h3 { font-size: 1.35rem; margin-bottom: 0.75rem; }
  .coverage-region ul { display: flex; gap: 0.3rem 1.5rem; flex-wrap: wrap; }
  .coverage-region li { font-size: 1rem; }
  .coverage-service-link { display: inline-block; margin-top: 1rem; color: var(--color-link-gold); text-decoration: underline; text-underline-offset: 0.2em; }
  .coverage-next { display: flex; gap: 1.5rem 3rem; flex-wrap: wrap; align-items: center; justify-content: space-between; }
  .coverage-next p { max-width: 55ch; margin-top: 0.75rem; }
  @media (min-width: 768px) {
    .coverage-intro { grid-template-columns: 1fr 1.5fr; gap: 4rem; }
    .coverage-directory { grid-template-columns: 1fr 1fr; }
  }
</style>
