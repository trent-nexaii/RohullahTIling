---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  PHONE_DISPLAY,
  PHONE_E164,
  EMAIL,
  LOCALITY,
  HOURS,
  GBP_URL,
  INSTAGRAM_URL,
} from '../data/business';

const title = "Contact Us | ROH Tiling Wellington";
const description = "Contact ROH Tiling for a free tiling quote in Wellington. Call 021 026 02044 or fill in our online form. Whitby-based, Wellington-wide.";
const canonical = "/contact";
const breadcrumbs = [{ name: "Home", url: "/" }, { name: "Contact" }];
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs} showMobileCTA={false}>
  <PageHeader
    title="Contact ROH Tiling"
    subtitle="Free, no-obligation quotes across Wellington. Call 021 026 02044, or send a message and Rohullah will get back to you."
  />

  <!-- Contact details and one quote/enquiry form -->
  <section class="section">
    <div class="container">
      <div class="contact-layout">

        <!-- Enquiry form -->
        <div class="contact-forms">

          <!-- Quote Request Form -->
          <div class="contact-form quote-form-card fade-in-up">
            <h2>Request a Free Quote</h2>
            <p class="form-intro">For a quote or a question, tell Rohullah what you need and where the property is. Name, email and a short message are all you need to get started.</p>

            <form
              action={`mailto:${EMAIL}`}
              method="post"
              enctype="text/plain"
              data-mailto={EMAIL}
              data-subject="Quote request from the ROH Tiling website"
              class="form"
            >
              <div class="form-row">
                <div class="form-group">
                  <label for="quote-name">Full Name <span class="required">*</span></label>
                  <input type="text" id="quote-name" name="full_name" required autocomplete="name" />
                </div>
                <div class="form-group">
                  <label for="quote-phone">Phone Number (optional)</label>
                  <input type="tel" id="quote-phone" name="phone" autocomplete="tel" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="quote-email">Email <span class="required">*</span></label>
                  <input type="email" id="quote-email" name="email" required autocomplete="email" />
                </div>
                <div class="form-group">
                  <label for="quote-suburb">Suburb / Location</label>
                  <input type="text" id="quote-suburb" name="suburb" autocomplete="address-level2" placeholder="e.g. Whitby, Porirua, Lower Hutt" />
                </div>
              </div>

              <div class="form-group">
                <label for="quote-description">Project or Question <span class="required">*</span></label>
                <textarea id="quote-description" name="description" rows="4" required placeholder="Tell us about your project — room size, tile type, any specific requirements..."></textarea>
              </div>

              <!-- Honeypot: hidden from humans, filled in by bots. Server accepts
                   silently and sends nothing when this has a value. -->
              <div class="hp-field" aria-hidden="true">
                <label for="quote-company">Company (leave blank)</label>
                <input type="text" id="quote-company" name="company" tabindex="-1" autocomplete="off" />
              </div>
              <button type="submit" class="btn btn-primary">Request Your Free Quote</button>
            </form>
          </div>
        </div>

        <!-- NAP Details Sidebar -->
        <aside class="contact-details fade-in-up">
          <h2 class="contact-details__heading">Get in Touch</h2>

          <address class="contact-nap">
            <div class="contact-nap__item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61 3.95 5.32 5.64 3.64C7.32 1.95 9.61 1 12 1C14.39 1 16.68 1.95 18.36 3.64C20.05 5.32 21 7.61 21 10Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/>
              </svg>
              <div>
                <strong>Service Area</strong>
                <p>{LOCALITY}</p>
                <p class="contact-nap__note">Service-area business &mdash; we come to you.</p>
              </div>
            </div>

            <div class="contact-nap__item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 16.92V19.92C22 20.48 21.56 20.93 21 20.97C20.68 21 20.35 21 20 21C10.61 21 3 13.39 3 4C3 3.65 3 3.32 3.03 3C3.07 2.44 3.52 2 4.08 2H7.08C7.56 2 7.99 2.34 8.07 2.81C8.14 3.27 8.23 3.73 8.36 4.17C8.47 4.55 8.36 4.96 8.07 5.24L6.62 6.69C8.06 9.43 10.57 11.94 13.31 13.38L14.76 11.93C15.04 11.64 15.45 11.53 15.83 11.64C16.27 11.77 16.73 11.86 17.19 11.93C17.66 12.01 18 12.44 18 12.92V15.92C18 16.48 17.56 16.93 17 16.97" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <strong>Phone</strong>
                <p><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></p>
              </div>
            </div>

            <div class="contact-nap__item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <strong>Email</strong>
                <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
              </div>
            </div>

            <div class="contact-nap__item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                <polyline points="12,6 12,12 16,14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <strong>Hours</strong>
                <!-- Mirrors the Google Business Profile exactly. Edit HOURS in
                     src/data/business.ts; this list and the LocalBusiness
                     openingHoursSpecification both derive from it. -->
                {HOURS.map((h) => (
                  <p>{h.label}: {h.value}</p>
                ))}
              </div>
            </div>

            <div class="contact-nap__item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" stroke="currentColor" stroke-width="1.5"/>
              </svg>
              <div>
                <strong>Find Us Online</strong>
                <p><a href={GBP_URL} rel="noopener" target="_blank">Google Business Profile</a></p>
                <p><a href={INSTAGRAM_URL} rel="noopener" target="_blank">Instagram &mdash; @rohtiling</a></p>
              </div>
            </div>
          </address>

          <div class="contact-response-note">
            <p>We will get back to you within 24 hours.</p>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <section class="section section--light"><div class="container contact-location"><h2>Based in Whitby.</h2><p>I come to your property. Check the <a href="/service-areas">service areas</a>, or send your suburb with your enquiry.</p><a class="text-link" href="https://maps.google.com/maps?q=Whitby%2C%20Porirua%2C%20Wellington%2C%20New%20Zealand" target="_blank" rel="noopener noreferrer">Find Whitby on Google Maps →</a></div></section>
</BaseLayout>

<style>
  .contact-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 6%; }
  .contact-nap { display: grid; gap: 24px; font-style: normal; }
  .contact-nap__item p { margin-bottom: 4px; }
  .contact-nap__item strong { display: block; margin-bottom: 6px; }
  .contact-nap__note { color: var(--color-muted); }
  .contact-details__heading { margin-bottom: 30px; }
  .contact-form h2 { margin-bottom: 20px; }
  .form-intro { margin-bottom: 35px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .form-group { margin-bottom: 25px; }
  .form-group label { display: block; font-size: 16px; font-weight: 500; margin-bottom: 10px; }
  .form-group input, .form-group textarea { width: 100%; padding: 14px; color: var(--color-dark-text); line-height: 1.5; }
  .form-group textarea { resize: vertical; }
  .contact-response-note { margin-top: 30px; }
  @media(max-width:899px) { .contact-layout { grid-template-columns: 1fr; gap: 40px; } }
  @media(max-width:599px) { .form-row { grid-template-columns: 1fr; gap: 0; } }
</style>
