---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  PHONE_DISPLAY,
  PHONE_E164,
  EMAIL,
  LOCALITY,
  GBP_URL,
  INSTAGRAM_URL,
} from "../data/business";
import { services } from "../data/services";
---

<BaseLayout
  title="Contact Us | ROH Tiling Wellington"
  description="Contact ROH Tiling for a free tiling quote in Wellington. Call 021 026 02044 or send your project details. Whitby-based, Wellington-wide."
  canonical="/contact"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Contact" }]}
>
  <section class="container contact-opening">
    <h1>Contact ROH Tiling</h1>
    <p>
      Tell Roh what you want tiled and where the property is. Free quotes, with
      a reply within 24 hours.
    </p>
    <a class="phone-text" href={`tel:${PHONE_E164}`}>
      Call Roh on {PHONE_DISPLAY}
    </a>
  </section>
  <div class="container contact-layout">
    <div class="contact-form" id="quote-form">
      <h2>Request a quote</h2>
      <p class="form-intro">
        A few details are enough to start. Choose phone or email; you only need
        to give one.
      </p>
      <form
        action={`mailto:${EMAIL}`}
        method="post"
        enctype="text/plain"
        data-mailto={EMAIL}
        data-subject="Quote request from the ROH Tiling website"
      >
        <div class="form-group">
          <label for="quote-name">Your name</label>
          <input
            id="quote-name"
            name="full_name"
            autocomplete="name"
            maxlength="120"
            required
          />
        </div>
        <fieldset class="contact-choice">
          <legend>How should Roh reply?</legend>
          <label>
            <input
              type="radio"
              name="preferred_contact"
              value="phone"
              checked
            />
            Phone
          </label>
          <label>
            <input type="radio" name="preferred_contact" value="email" />
            Email
          </label>
        </fieldset>
        <div class="form-group">
          <label id="contact-detail-label" for="quote-contact">
            Phone or email
          </label>
          <input
            id="quote-contact"
            name="contact_detail"
            type="text"
            maxlength="254"
            required
          />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="quote-suburb">Property suburb</label>
            <input
              id="quote-suburb"
              name="suburb"
              autocomplete="address-level2"
              maxlength="160"
              required
            />
          </div>
          <div class="form-group">
            <label for="quote-service">What needs work?</label>
            <select id="quote-service" name="service" required>
              <option value="">Choose a service</option>
              {services.map((service) => (
                <option value={service.id}>{service.name}</option>
              ))}
              <option value="not-sure">Not sure / more than one</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="quote-description">A little about the job</label>
          <textarea
            id="quote-description"
            name="description"
            rows="4"
            maxlength="5000"
            required
            placeholder="What needs tiling? Add measurements or tile choices if you have them."
          ></textarea>
        </div>
        <div class="form-group">
          <label for="quote-photo">Add a photo (optional)</label>
          <input
            id="quote-photo"
            name="photo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            aria-describedby="photo-hint"
            disabled
          />
          <p id="photo-hint" class="form-hint">
            One JPG, PNG or WebP, up to 2 MB. A wider view of the space is
            useful. Please leave out people and personal documents.
          </p>
        </div>
        <noscript>
          <p class="form-hint">
            This form opens your email app. Attach a photograph there and press
            send, or <a href={`mailto:${EMAIL}`}>email Roh directly</a>.
          </p>
        </noscript>
        <p class="form-hint">
          Your details are used to respond to this enquiry.{" "}
          <a href="/privacy">Read the privacy policy</a>.
        </p>
        <div class="hp-field" aria-hidden="true">
          <label for="quote-company">Company (leave blank)</label>
          <input
            type="text"
            id="quote-company"
            name="company"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <button type="submit" class="btn btn-primary">
          Request a quote
        </button>
        <div
          class="form-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden
        ></div>
      </form>
    </div>
    <aside class="contact-details">
      <h2>Talk directly to Roh.</h2>
      <address>
        <a class="contact-phone" href={`tel:${PHONE_E164}`}>
          {PHONE_DISPLAY}
        </a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <p>{LOCALITY}</p>
      </address>
      <div>
        <h3>Based in Whitby</h3>
        <p>
          ROH is a service-area business. Roh comes to your property; there is
          no public shopfront.
        </p>
        <p>
          Working across Wellington, Porirua, the Hutt Valley and Kāpiti.{" "}
          <a href="/service-areas">Check your location</a>.
        </p>
        <h3>Find the right service</h3>
        <p>
          <a href="/services">Bathroom, kitchen and floor tiling</a>, plus
          wet-area preparation and repairs. Include your questions in the form.
        </p>
        <p>
          <a href={GBP_URL} target="_blank" rel="noopener noreferrer">
            Google Business Profile
          </a>
          <br />
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
            Instagram
          </a>
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
