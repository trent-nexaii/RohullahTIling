---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import { Image } from 'astro:assets';
import { OWNER_NAME } from '../data/business';
import roh from '../assets/images/rohullah-rassuli-tiler-wellington.webp';
import ensuite from '../assets/images/ensuite-large-format-porcelain-tiling-wellington.webp';
import teal from '../assets/images/shower-tiling-vertical-stack-teal-tile-wellington.webp';
import corner from '../assets/images/kitchen-splashback-fluted-terracotta-tile-wellington.webp';
const title = 'About Us | ROH Tiling Wellington';
const description = 'Meet Rohullah Rassuli — Whitby-based professional tiler with 10+ years experience serving Wellington. Quality craftsmanship, honest pricing, and free quotes.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'About' }];
---
<BaseLayout title={title} description={description} canonical="/about" breadcrumbs={breadcrumbs}>
  <PageHeader title="About ROH Tiling" subtitle="An owner-operated tiling business in Whitby, Porirua. Ten years on the tools, and every tile laid personally." />
  <section class="section container owner-layout about-owner">
    <figure><Image src={roh} alt={`${OWNER_NAME}, owner of ROH Tiling, on site in Wellington`} width={700} widths={[350, 500, 700]} sizes="(min-width: 900px) 35vw, 80vw" quality={78} format="webp" loading="eager" /></figure>
    <div><h2>One person.<br />From quote to grout.</h2><p>I have been on the tools for over ten years, and I still lay every tile myself. When you call ROH Tiling you get me on the phone, me doing the quote, and me on site.</p><p>That is deliberate. Tiling is a trade where the difference between a good job and a bad one is hidden behind the tile: the substrate prep, the falls to the drain, the waterproofing.</p><p>I am based in Whitby and work across Porirua, Wellington City, the Hutt Valley and the Kapiti Coast.</p><a class="text-link" href="/contact">Talk through your project</a></div>
  </section>
  <section class="section section--light"><div class="container job-list"><div><h2>Before the first tile.</h2><p>The visible finish starts with the work underneath it.</p></div><dl class="work-method"><div><dt>A site visit and a quote</dt><dd>Discuss the space, measurements, tile choice and the work involved. Quotes are free and without obligation.</dd></div><div><dt>Preparation and setting out</dt><dd>Assess the surface, plan the layout, and prepare the substrate. Waterproofing is discussed where wet-area work requires it.</dd></div><div><dt>Laying and finishing</dt><dd>Cut and lay the tiles, grout the joints, seal the junctions with silicone, then clean the workspace.</dd></div></dl></div></section>
  <section class="section container about-work"><div class="work-intro"><h2>The work, up close.</h2><p>Finished work and photographs taken during installation. The portfolio explains the setting-out decisions behind each one.</p></div><div class="about-photo-layout"><figure><a href="/portfolio#ensuite-large-format-porcelain"><Image src={ensuite} alt="Completed large-format porcelain ensuite" width={850} widths={[350, 600, 850]} sizes="(min-width: 900px) 42vw, 92vw" quality={78} format="webp" loading="lazy" /></a><figcaption>Porcelain ensuite. Finished work.</figcaption></figure><figure><a href="/portfolio#fluted-terracotta-splashback"><Image src={corner} alt="Fluted terracotta kitchen splashback corner during installation" width={650} widths={[350, 500, 650]} sizes="(min-width: 900px) 33vw, 80vw" quality={78} format="webp" loading="lazy" /></a><figcaption>Fluted corner return. Work in progress.</figcaption></figure><figure><a href="/portfolio#teal-stack-bond-shower"><Image src={teal} alt="Teal vertical stack-bond shower beneath a skylight during installation" width={1000} widths={[400, 700, 1000]} sizes="(min-width: 900px) 65vw, 92vw" quality={78} format="webp" loading="lazy" /></a><figcaption>Stack-bond shower. Work in progress.</figcaption></figure></div></section>
  <div class="container about-next-links"><a href="/services">Choose a tiling service</a><a href="/portfolio">Read the project notes</a></div>
  <CTASection />
</BaseLayout>
