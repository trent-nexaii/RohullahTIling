---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { Image } from 'astro:assets';
import splashbackImg from '../../assets/images/kitchen-splashback-fluted-terracotta-tile-wellington.webp';

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Services' }];
const services = [
  { name: 'Bathroom Tiling', href: '/services/bathroom-tiling', description: 'Shower walls, bathroom floors and floor-to-ceiling tiling. Explore layouts, tile options and preparation.' },
  { name: 'Kitchen Tiling', href: '/services/kitchen-tiling', description: 'Kitchen splashbacks, feature walls and floors, from subway tiles to fluted corner returns.' },
  { name: 'Floor Tiling', href: '/services/floor-tiling', description: 'Porcelain, ceramic and natural stone floors for homes and commercial spaces.' },
  { name: 'Waterproofing', href: '/services/waterproofing', description: 'Membrane preparation and installation beneath tiles in showers, bathrooms and other wet areas.' },
  { name: 'Underfloor Heating', href: '/services/underfloor-heating', description: 'Electric heating beneath tiled floors, planned alongside the tiling work.' },
  { name: 'Tile Repairs', href: '/services/tile-repairs', description: 'Cracked tile replacement, re-grouting and re-siliconing for existing tiled surfaces.' },
];
---

<BaseLayout
  title="Tiling Services Wellington | ROH Tiling"
  description="Professional tiling services in Wellington. Bathroom, kitchen & floor tiling, waterproofing, underfloor heating & repairs. Free quotes — call 021 026 02044."
  canonical="/services"
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    title="Professional Tiling Services in Wellington"
    subtitle="Bathrooms, kitchen splashbacks, floors and repairs — choose the work you need, then talk it through with Rohullah."
  />

  <section class="section">
    <div class="container service-directory">
      <div>
        <h2 class="directory-heading">Choose your service</h2>
        <ul class="service-list">
          {services.map((service) => (
            <li>
              <h3><a href={service.href}>{service.name}<span aria-hidden="true"> ↗</span></a></h3>
              <p>{service.description}</p>
            </li>
          ))}
        </ul>
      </div>
      <figure class="work-detail">
        <a href="/portfolio#fluted-terracotta-splashback">
          <Image
            src={splashbackImg}
            alt="Fluted terracotta kitchen tiles with the ribs aligned across an internal corner, photographed during work"
            width={520}
            widths={[360, 520, 780]}
            sizes="(min-width: 900px) 38vw, 90vw"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={75}
          />
        </a>
        <figcaption>
          <h2>The detail at the corner</h2>
          <p>Ribs aligned across the return on this fluted-tile splashback. Photographed on site, work in progress.</p>
          <a class="text-link" href="/portfolio#fluted-terracotta-splashback">See Rohullah’s workmanship notes →</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--light">
    <div class="container service-next">
      <div>
        <h2 class="directory-heading">Talk through your tiling job</h2>
        <p>Tell Rohullah what you want tiled and where the property is. Include room measurements or tile choices if you have them.</p>
        <p>Based in Whitby. Check the <a class="text-link" href="/service-areas">service areas</a> for coverage.</p>
      </div>
      <a href="/contact" class="btn btn-primary">Request a Free Quote</a>
    </div>
  </section>
</BaseLayout>

<style>
  .service-directory { display: grid; gap: 3rem; align-items: start; }
  .directory-heading { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 1.5rem; }
  .service-list { display: grid; gap: 1.75rem; }
  .service-list h3 { font-size: 1.25rem; margin-bottom: 0.35rem; }
  .service-list a { text-decoration: underline; text-underline-offset: 0.25em; }
  .service-list a:hover { color: var(--color-link-gold); }
  .service-list a span { color: var(--color-link-gold); }
  .service-list p { max-width: 58ch; }
  .work-detail { background: var(--color-light-bg); }
  .work-detail img { width: 100%; height: auto; }
  .work-detail figcaption { padding: 1.5rem; }
  .work-detail h2 { font-size: 1.5rem; margin-bottom: 0.75rem; }
  .work-detail p { margin-bottom: 1rem; }
  .text-link { color: var(--color-link-gold); text-decoration: underline; text-underline-offset: 0.2em; }
  .service-next { display: flex; gap: 2rem; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .service-next p { max-width: 60ch; margin-bottom: 0.75rem; }
  .service-next .btn { flex-shrink: 0; }
  @media (min-width: 900px) {
    .service-directory { grid-template-columns: 1.3fr 1fr; gap: 4rem; }
  }
</style>
