---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import { Image } from "astro:assets";
import splashback from "../../assets/images/kitchen-splashback-fluted-terracotta-tile-wellington.webp";
import { services, servicePath, quotePath } from "../../data/services";
import { PHONE_DISPLAY, PHONE_E164 } from "../../data/business";
---

<BaseLayout
  title="Tiling Services Wellington | ROH Tiling"
  description="Bathrooms, kitchen splashbacks, tiled floors and repairs. Explore ROH's six tiling services, see the work and plan a quote with Whitby-based owner Roh."
  canonical="/services"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Services" }]}
>
  <section class="container service-opening directory-opening">
    <div>
      <h1>Professional Tiling Services in Wellington</h1>
      <p>
        Choose the work you need, then talk through the room, preparation and
        tile choice with Roh. Owner-operated and based in Whitby.
      </p>
      <div class="opening-actions">
        <a class="btn btn-primary" href="/contact#quote-form">
          Request a quote
        </a>
        <a class="phone-text" href={`tel:${PHONE_E164}`}>
          {PHONE_DISPLAY}
        </a>
      </div>
    </div>
    <figure>
      <Image
        src={splashback}
        alt="ROH fluted terracotta splashback with the ribs aligned around a corner, during installation"
        width={900}
        widths={[420, 640, 900]}
        sizes="(min-width: 900px) 48vw, 90vw"
        quality={78}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        Setting out a fluted corner return. Work in progress.{" "}
        <a href="/portfolio#fluted-terracotta-splashback">
          Read the project notes
        </a>
        .
      </figcaption>
    </figure>
  </section>
  <nav class="container service-page-nav" aria-label="Choose a service group">
    <a href="#core-services">Bathrooms, kitchens and floors</a>
    <a href="#other-services">Other tiling work</a>
  </nav>
  <section class="section section--white">
    <div class="container directory-layout">
      <div>
        <h2 id="core-services">Bathrooms, kitchens and floors</h2>
        <ul class="directory-list">
          {services
            .filter((service) => service.primary)
            .map((service) => (
              <li>
                <h3>
                  <a href={servicePath(service.id)}>{service.name}</a>
                </h3>
                <p>{service.description}</p>
                <a class="directory-quote" href={quotePath(service.id)}>
                  Ask about {service.name.toLowerCase()}
                </a>
              </li>
            ))}
        </ul>
      </div>
      <aside class="directory-help">
        <h2>Not sure where to start?</h2>
        <p>
          Tell Roh what is there now, what you want to change and your suburb. A
          photograph and rough measurements help the conversation.
        </p>
        <p>
          For a bathroom renovation, discuss the tiling and the wet-area work
          together. For a floor, start with the existing surface and finished
          levels.
        </p>
        <a href="/service-areas">Check your service area</a>
      </aside>
    </div>
  </section>
  <section class="section container">
    <h2 id="other-services">Other tiling work</h2>
    <ul class="supporting-directory">
      {services
        .filter((service) => !service.primary)
        .map((service) => (
          <li>
            <h3>
              <a href={servicePath(service.id)}>{service.name}</a>
            </h3>
            <p>{service.description}</p>
          </li>
        ))}
    </ul>
  </section>
  <CTASection />
</BaseLayout>
<style>
  .directory-opening h1 {
    font-size: clamp(2.35rem, 4vw, 3.5rem);
    margin-bottom: 24px;
  }
  .directory-layout {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr;
    gap: 13%;
  }
  .directory-layout h2 {
    max-width: 18ch;
  }
  .directory-list li {
    padding-block: 28px;
    border-bottom: 1px solid var(--color-border-warm);
  }
  .directory-list li:first-child {
    padding-top: 0;
  }
  .directory-list h3 {
    font-size: 1.35rem;
  }
  .directory-list p {
    margin-bottom: 14px;
    max-width: 51ch;
  }
  .directory-quote {
    font-size: 0.875rem;
  }
  .directory-help {
    padding-top: 4px;
  }
  .directory-help h2 {
    font-size: 2rem;
  }
  .directory-help p {
    font-size: 1rem;
  }
  .supporting-directory {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6%;
  }
  .supporting-directory li {
    border-top: 1px solid var(--color-border-warm);
    padding-top: 24px;
  }
  .supporting-directory p {
    font-size: 1rem;
  }
  @media (max-width: 899px) {
    .directory-layout {
      gap: 7%;
    }
    .supporting-directory {
      gap: 5%;
    }
  }
  @media (max-width: 599px) {
    .directory-layout,
    .supporting-directory {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .directory-opening h1 {
      font-size: 2.35rem;
    }
    .directory-help {
      padding-top: 10px;
    }
    .supporting-directory li {
      padding-top: 22px;
    }
    .supporting-directory {
      gap: 22px;
    }
  }
</style>
