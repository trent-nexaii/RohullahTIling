---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import { business } from '../data/business';

interface Props {
  title: string;
  description: string;
  canonical: string;
  serviceName: string;
  serviceType: string;
  serviceDescription: string;
}

const {
  title,
  description,
  canonical,
  serviceName,
  serviceType,
  serviceDescription,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? business.url;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: serviceName },
];

/**
 * The provider is a reference to the LocalBusiness declared once in
 * BaseLayout, not a second copy of it. Two LocalBusiness nodes on one page
 * reads as two businesses.
 */
const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${siteUrl}${canonical}#service`,
  serviceType,
  name: serviceName,
  description: serviceDescription,
  url: `${siteUrl}${canonical}`,
  provider: { '@id': `${siteUrl}/#business` },
  areaServed: business.areaServed.map((area) => ({
    '@type': 'Place',
    name: area,
  })),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  schemas={serviceSchema}
>
  <PageHeader title={serviceName} breadcrumbs={breadcrumbs} />

  <slot />

  <CTASection
    heading={`Need ${serviceName} in Wellington?`}
    text="Get in touch for a free, no-obligation quote. Call for a straight answer, or send the details through the quote form and I will come and price it up."
    variant="gold"
  />
</BaseLayout>
