---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import { services, quotePath } from '../data/services';

interface Props {
  title: string;
  description: string;
  canonical: string;
  serviceName: string;
  serviceType: string;
  serviceDescription: string;
}

const {
  title,
  description,
  canonical,
  serviceName,
  serviceType,
  serviceDescription,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.rohullahtiling.co.nz';
const service = services.find((item) => canonical === `/services/${item.id}`);
const enquiryHref = service ? quotePath(service.id) : '/contact#quote-form';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: serviceName },
];

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteUrl}${canonical}#service`,
  "serviceType": serviceType,
  "name": serviceName,
  "description": serviceDescription,
  "url": `${siteUrl}${canonical}`,
  // Points at the single LocalBusiness node defined in BaseLayout.
  "provider": { "@id": `${siteUrl}/#business` },
  "areaServed": [
    { "@type": "City", "name": "Wellington" },
    { "@type": "City", "name": "Porirua" },
    { "@type": "City", "name": "Lower Hutt" },
    { "@type": "City", "name": "Upper Hutt" },
    { "@type": "Place", "name": "Kapiti Coast" }
  ]
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  schemas={serviceSchema}
  quoteHref={enquiryHref}
>
  <PageHeader title={serviceName} subtitle={serviceDescription} actionHref={enquiryHref} compact={service?.primary} />
  {service?.primary && <nav class="container service-page-nav" aria-label="On this service page"><a href="#recent-work">See the work</a><a href="#service-scope">What is included</a><a href="#quote-details">Plan your quote</a></nav>}

  <slot />

  <CTASection service={service?.id} />
</BaseLayout>
