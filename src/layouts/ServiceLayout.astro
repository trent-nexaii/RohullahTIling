---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  serviceName: string;
  serviceType: string;
  serviceDescription: string;
}

const {
  title,
  description,
  canonical,
  serviceName,
  serviceType,
  serviceDescription,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.rohullahtiling.co.nz';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: serviceName },
];

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteUrl}${canonical}#service`,
  "serviceType": serviceType,
  "name": serviceName,
  "description": serviceDescription,
  "url": `${siteUrl}${canonical}`,
  // Points at the single LocalBusiness node defined in BaseLayout.
  "provider": { "@id": `${siteUrl}/#business` },
  "areaServed": [
    { "@type": "City", "name": "Wellington" },
    { "@type": "City", "name": "Porirua" },
    { "@type": "City", "name": "Lower Hutt" },
    { "@type": "City", "name": "Upper Hutt" },
    { "@type": "Place", "name": "Kapiti Coast" }
  ]
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  schemas={serviceSchema}
>
  <PageHeader title={canonical === '/services/kitchen-tiling' ? 'Kitchen Tiling & Splashbacks in Wellington' : `${serviceName} in Wellington`} subtitle={serviceDescription} />

  <slot />

  <CTASection
    heading="Ready to Start Your Tiling Project?"
    text="Get in touch with ROH Tiling for a free, no-obligation quote. We'd love to help bring your vision to life."
    variant="gold"
  />
</BaseLayout>
