---
import { SITE_URL, AREA_SERVED } from '../data/business';
import { canonicalUrlFor } from '../lib/seo';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  serviceName: string;
  serviceType: string;
  serviceDescription: string;
}

const {
  title,
  description,
  canonical,
  serviceName,
  serviceType,
  serviceDescription,
} = Astro.props;

const siteUrl = SITE_URL;
const serviceUrl = canonicalUrlFor(canonical);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: serviceName },
];

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${serviceUrl}#service`,
  "serviceType": serviceType,
  "name": serviceName,
  "description": serviceDescription,
  "url": serviceUrl,
  "mainEntityOfPage": { "@id": `${serviceUrl}#webpage` },
  // Points at the single LocalBusiness node defined in BaseLayout.
  "provider": { "@id": `${siteUrl}/#business` },
  "areaServed": AREA_SERVED
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  schemas={serviceSchema}
>
  <PageHeader title={canonical === '/services/kitchen-tiling' ? 'Kitchen Tiling & Splashbacks in Wellington' : `${serviceName} in Wellington`} subtitle={serviceDescription} />

  <slot />

  <CTASection
    heading="Ready to Start Your Tiling Project?"
    text="Get in touch with ROH Tiling for a free, no-obligation quote. We'd love to help bring your vision to life."
    variant="gold"
  />
</BaseLayout>
