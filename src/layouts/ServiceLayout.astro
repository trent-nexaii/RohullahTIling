---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import { business } from '../data/business';

interface Props {
  title: string;
  description: string;
  canonical: string;
  serviceName: string;
  serviceType: string;
  serviceDescription: string;
}

const {
  title,
  description,
  canonical,
  serviceName,
  serviceType,
  serviceDescription,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.rohullahtiling.co.nz';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: serviceName },
];

// `provider` points at the single LocalBusiness node that BaseLayout emits
// rather than declaring a second one, so the site has exactly one business
// entity across every page.
const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteUrl}${canonical}#service`,
  "serviceType": serviceType,
  "name": serviceName,
  "description": serviceDescription,
  "url": `${siteUrl}${canonical}`,
  "provider": { "@id": `${siteUrl}/#business` },
  "areaServed": business.areaServed.map((name) => ({
    "@type": "Place",
    name,
  })),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  schemas={serviceSchema}
>
  <PageHeader title={serviceName} breadcrumbs={breadcrumbs} />

  <slot />

  <CTASection
    heading="Ready to Start Your Tiling Project?"
    text="Get in touch with ROH Tiling for a free, no-obligation quote. We'd love to help bring your vision to life."
    variant="gold"
  />
</BaseLayout>
