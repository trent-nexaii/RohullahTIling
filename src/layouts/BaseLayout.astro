---
import '../styles/global.css';
import { business, services } from '../data/business';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  breadcrumbs?: { name: string; url?: string }[];
  schemas?: string;
  showMobileCTA?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  breadcrumbs,
  schemas,
  showMobileCTA = true,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? business.url;
const canonicalUrl = `${siteUrl}${canonical}`;
const currentPath = Astro.url.pathname;

/**
 * The single LocalBusiness node for the whole site. Everything else that needs
 * to point at the business references this `@id` rather than declaring its own
 * copy, so there is exactly one LocalBusiness block per page.
 *
 * No aggregateRating and no review: the business has no reviews on any
 * platform, and marking up ratings that do not exist invites a manual action.
 */
const businessId = `${siteUrl}/#business`;

const localBusinessSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': businessId,
  name: business.name,
  legalName: business.registeredName,
  description: `Tiling for bathrooms, showers, kitchens, splashbacks and floors across the Wellington region. Based in ${business.base}, ${business.yearsExperience} on the tools.`,
  url: business.url,
  telephone: business.phoneE164,
  email: business.email,
  image: `${siteUrl}/images/og-image.jpg`,
  founder: {
    '@type': 'Person',
    name: business.owner,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.locality,
    addressRegion: business.region,
    addressCountry: 'NZ',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  openingHours: business.hours.schema,
  areaServed: business.areaServed.map((area) => ({
    '@type': 'Place',
    name: area,
  })),
  makesOffer: services.map((service) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: service.name,
      description: service.schemaDescription,
      url: `${siteUrl}${service.href}`,
      provider: { '@id': businessId },
    },
  })),
  priceRange: '$$',
});

let breadcrumbSchema = '';
if (breadcrumbs && breadcrumbs.length > 0) {
  breadcrumbSchema = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      ...(crumb.url ? { item: `${siteUrl}${crumb.url}` } : {}),
    })),
  });
}

const year = new Date().getFullYear();

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(path);
}

const navLinks = [
  { name: 'Services', href: '/services', children: services },
  { name: 'Portfolio', href: '/portfolio' },
  { name: 'Service Areas', href: '/service-areas' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];
---

<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Marks that scripting is available, before first paint. The scroll-reveal
       animation hides its elements only under `.js`, so without this the page
       renders in full rather than staying blank. -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph. The image is a JPG: Facebook, LinkedIn, WhatsApp and
       Messenger do not render SVG, so an SVG share card shows nothing. -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="en_NZ" />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:image" content={`${siteUrl}/images/og-image.jpg`} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`Teal vertical tile shower and wall-hung vanity, installed by ${business.name}`} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/images/og-image.jpg`} />

  <!-- Fonts are self-hosted (see the @font-face rules in global.css), so there
       is no render-blocking stylesheet from a third party and no extra
       connection to open. Preloaded because the CSS that references them is
       itself a stylesheet, which would otherwise delay their discovery. -->
  <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/playfair-display-latin.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={localBusinessSchema} />

  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={breadcrumbSchema} />
  )}

  {schemas && (
    <script type="application/ld+json" set:html={schemas} />
  )}

  <slot name="head" />
</head>
<body>

  <!-- ========== NAVIGATION ========== -->
  <header class="site-header" id="site-header">
    <div class="nav-container">
      <!-- No aria-label: the visible logo text is already the accessible name,
           and an aria-label that omits it fails label-content-name-mismatch. -->
      <a href="/" class="logo">
        <span class="logo-name">ROH TILING</span>
        <span class="logo-tagline">WELLINGTON TILER</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="nav-desktop" aria-label="Main navigation">
        {navLinks.map((link) =>
          link.children ? (
            <div class="nav-dropdown">
              <a
                href={link.href}
                class={`nav-link${isActive(link.href) ? ' active' : ''}`}
              >
                {link.name}
              </a>
              <ul class="nav-dropdown-menu">
                {link.children.map((child) => (
                  <li>
                    <a href={child.href} class={isActive(child.href) ? 'active' : ''}>
                      {child.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={link.href}
              class={`nav-link${isActive(link.href) ? ' active' : ''}`}
            >
              {link.name}
            </a>
          )
        )}
      </nav>

      <!-- Phone Link -->
      <a href={business.phoneLink} class="nav-phone" aria-label={`Call ROH Tiling on ${business.phone}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>{business.phone}</span>
      </a>

      <!-- Hamburger Button -->
      <button class="hamburger" id="hamburger" aria-label="Toggle navigation menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile Navigation Overlay -->
    <nav class="nav-mobile" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a href={link.href}>{link.name}</a>
      ))}
      {services.map((link) => (
        <a href={link.href} class="nav-mobile__sub">{link.name}</a>
      ))}
      <a href={business.phoneLink} style="color: var(--color-primary);">{business.phone}</a>
    </nav>
  </header>

  <!-- ========== PAGE CONTENT ========== -->
  <main>
    <slot />
  </main>

  <!-- ========== FOOTER ========== -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-col">
        <a href="/" class="footer-logo">
          <span class="logo-name">ROH TILING</span>
          <span class="logo-tagline">WELLINGTON TILER</span>
        </a>
        <p class="footer-desc">
          Tiling for bathrooms, showers, kitchens, splashbacks and floors across the Wellington region. {business.yearsExperience} on the tools, based in {business.base}.
        </p>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Contact Us</h3>
        <address class="footer-contact">
          <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {business.base}, {business.country}
          </p>
          <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={business.phoneLink}>{business.phone}</a>
          </p>
          <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </p>
          <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>
              {business.hours.display.map((slot) => (
                <span class="footer-hours-line">{slot.days}: {slot.time}</span>
              ))}
            </span>
          </p>
        </address>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Quick Links</h3>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/portfolio">Portfolio</a></li>
          <li><a href="/service-areas">Service Areas</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Our Services</h3>
        <ul class="footer-links">
          {services.map((link) => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="container footer-bottom-inner">
        <div class="footer-bottom-left">
          <span>&copy; {year} {business.name}. All rights reserved.</span>
          <span class="footer-bottom-sep">|</span>
          <a href="/privacy">Privacy Policy</a>
          <span class="footer-bottom-sep">|</span>
          <a href="/terms">Terms of Service</a>
        </div>
        <div class="footer-bottom-right">
          <a href="https://www.nexaii.com" target="_blank" rel="noopener noreferrer">Website designed by Nexaii</a>
        </div>
      </div>
      <div class="container footer-registered">
        <span>{business.name} is the trading name of {business.registeredName}.</span>
      </div>
    </div>
  </footer>

  <!-- ========== MOBILE STICKY CTA BAR ========== -->
  {showMobileCTA && (
    <div class="mobile-cta-bar" id="mobile-cta-bar">
      <a href={business.phoneLink} class="mobile-cta-btn mobile-cta-phone" aria-label={`Call Now: ${business.phone}`}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Call Now
      </a>
      <a href="/contact" class="mobile-cta-btn mobile-cta-quote">Get a Free Quote</a>
    </div>
  )}

  <!-- Client-side JS -->
  <script is:inline src="/js/main.js" defer></script>
</body>
</html>

<style is:global>
  .nav-mobile__sub {
    font-size: 1.1rem;
    opacity: 0.8;
  }

  .footer-hours-line {
    display: block;
  }

  .footer-registered {
    padding-top: 0.75rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
  }
</style>
