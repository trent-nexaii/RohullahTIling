---
import '../styles/global.css';
import { business, serviceLinks, localBusinessSchema } from '../data/business';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  breadcrumbs?: { name: string; url?: string }[];
  schemas?: string;
  showMobileCTA?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  breadcrumbs,
  schemas,
  showMobileCTA = true,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.rohullahtiling.co.nz';
const canonicalUrl = `${siteUrl}${canonical}`;
const currentPath = Astro.url.pathname;

const businessSchema = localBusinessSchema(siteUrl);

let breadcrumbSchema = '';
if (breadcrumbs && breadcrumbs.length > 0) {
  breadcrumbSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name,
      ...(crumb.url ? { "item": `${siteUrl}${crumb.url}` } : {})
    }))
  });
}

const year = new Date().getFullYear();

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(path);
}

const navLinks = [
  { name: 'Services', href: '/services', children: serviceLinks },
  { name: 'Portfolio', href: '/portfolio' },
  { name: 'Service Areas', href: '/service-areas' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];
---

<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="en_NZ" />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:image" content={`${siteUrl}/images/og-image.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="ROH Tiling, Wellington tiler. Finished bathroom tiling." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/images/og-image.jpg`} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@400;500;700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@400;500;700&display=swap"
    />
  </noscript>

  <!-- LocalBusiness schema: the single block for the whole site -->
  <script type="application/ld+json" set:html={businessSchema} />

  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={breadcrumbSchema} />
  )}

  {schemas && (
    <script type="application/ld+json" set:html={schemas} />
  )}
</head>
<body>

  <!-- ========== NAVIGATION ========== -->
  <header class="site-header" id="site-header">
    <div class="nav-container">
      <a href="/" class="logo" aria-label="ROH Tiling — Home">
        <span class="logo-name">ROH TILING</span>
        <span class="logo-tagline">WELLINGTON TILER</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="nav-desktop" aria-label="Main navigation">
        {navLinks.map((link) =>
          link.children ? (
            <div class="nav-dropdown">
              <a
                href={link.href}
                class={`nav-link${isActive(link.href) ? ' active' : ''}`}
              >
                {link.name}
              </a>
              <ul class="nav-dropdown-menu">
                {link.children.map((child) => (
                  <li>
                    <a href={child.href} class={isActive(child.href) ? 'active' : ''}>
                      {child.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={link.href}
              class={`nav-link${isActive(link.href) ? ' active' : ''}`}
            >
              {link.name}
            </a>
          )
        )}
      </nav>

      <!-- Phone Link -->
      <a href={business.phoneHref} class="nav-phone" aria-label={`Call us on ${business.phoneDisplay}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>{business.phoneDisplay}</span>
      </a>

      <!-- Hamburger Button -->
      <button class="hamburger" id="hamburger" aria-label="Toggle navigation menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile Navigation Overlay -->
    <nav class="nav-mobile" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a href={link.href}>{link.name}</a>
      ))}
      {serviceLinks.map((link) => (
        <a href={link.href} style="font-size: 1.1rem; opacity: 0.8;">{link.name}</a>
      ))}
      <a href={business.phoneHref} style="color: var(--color-primary);">{business.phoneDisplay}</a>
    </nav>
  </header>

  <!-- ========== PAGE CONTENT ========== -->
  <main>
    <slot />
  </main>

  <!-- ========== FOOTER ========== -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-col">
        <a href="/" class="footer-logo" aria-label="Home">
          <span class="logo-name">ROH TILING</span>
          <span class="logo-tagline">WELLINGTON TILER</span>
        </a>
        <p class="footer-desc">
          Wellington tiler covering bathrooms, showers, kitchens, splashbacks and floors. Based in Whitby, Porirua, with over 10 years on the tools.
        </p>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Contact Us</h3>
        <address class="footer-contact">
          <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Whitby, Porirua, New Zealand
          </p>
          <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={business.phoneHref}>{business.phoneDisplay}</a>
          </p>
          <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </p>
          <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>
              Mon to Fri: 7:00am to 6:00pm<br />
              Sat: 8:00am to 2:00pm
            </span>
          </p>
        </address>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Quick Links</h3>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/service-areas">Service Areas</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Our Services</h3>
        <ul class="footer-links">
          {serviceLinks.map((link) => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <p class="footer-legal-name">{business.legalName}</p>

    <div class="footer-bottom">
      <div class="container footer-bottom-inner">
        <div class="footer-bottom-left">
          <span>&copy; {year} {business.name}. All rights reserved.</span>
          <span class="footer-bottom-sep">|</span>
          <a href="/privacy">Privacy Policy</a>
          <span class="footer-bottom-sep">|</span>
          <a href="/terms">Terms of Service</a>
        </div>
        <div class="footer-bottom-right">
          <a href="https://www.nexaii.com" target="_blank" rel="noopener noreferrer">Website designed by Nexaii</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- ========== MOBILE STICKY CTA BAR ========== -->
  {showMobileCTA && (
    <div class="mobile-cta-bar" id="mobile-cta-bar">
      <a href={business.phoneHref} class="mobile-cta-btn mobile-cta-phone" aria-label="Call us">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Call Now
      </a>
      <a href="/contact" class="mobile-cta-btn mobile-cta-quote">Get a Free Quote</a>
    </div>
  )}

  <!-- Client-side JS -->
  <script is:inline src="/js/main.js"></script>
</body>
</html>
