---
interface Props { title: string; subtitle?: string; }
const { title, subtitle } = Astro.props;
---
<section class:list={['page-header', 'container', { 'page-header--long': title.length > 32 }]}>
  <h1>{title}</h1>
  <div>{subtitle && <p>{subtitle}</p>}<a class="text-link" href="/contact">Discuss your tiling job →</a></div>
</section>
