---
/**
 * Inner-page hero.
 *
 * The visible breadcrumb trail was removed — on a nine-page site it added a
 * link path above every H1 without helping anyone navigate. The BreadcrumbList
 * schema is unaffected: it is emitted from BaseLayout and still describes the
 * hierarchy to Google.
 */
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="page-header">
  <div class="container page-header__inner">
    <span class="page-header__rule" aria-hidden="true"></span>
    <h1 class="page-header__title">{title}</h1>
    {subtitle && <p class="page-header__subtitle">{subtitle}</p>}
  </div>
</section>
